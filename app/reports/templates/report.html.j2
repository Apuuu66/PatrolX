<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>PatrolX 巡检报告 - {{ task_id }}</title>
  <style>
    body { font-family: -apple-system, "PingFang SC", sans-serif; margin: 32px; color: #333; }
    h1 { font-size: 20px; }
    h2 { font-size: 16px; margin-top: 24px; }
    .stats { display: flex; gap: 12px; margin: 16px 0; }
    .stat { border: 1px solid #eee; border-radius: 8px; padding: 12px 20px; }
    table { border-collapse: collapse; width: 100%; margin-top: 12px; }
    th, td { border: 1px solid #eee; padding: 8px 12px; text-align: left; font-size: 14px; }
    th { background: #fafafa; }
    .finding { margin: 8px 0; padding: 8px 12px; border-left: 3px solid #faad14; background: #fffbe6; }
    .alarm-priority { margin: 12px 0 16px; padding: 12px 16px; border: 1px solid #ffccc7; border-radius: 8px; background: #fff2f0; }
    .alarm-priority .stats { margin: 0 0 12px; }
    .alarm-priority .stat { background: #fff; }
    .alarm-note { color: #8c8c8c; font-size: 12px; margin: 6px 0; }
    .daily-health { margin: 16px 0; padding: 16px; border: 1px solid #d9e4f5; border-radius: 8px; background: #f8fbff; }
    .daily-health .stats { flex-wrap: wrap; margin: 8px 0; }
    .daily-health .stat { background: #fff; }
    .daily-health-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .daily-health-grid h3, .daily-health h3 { font-size: 14px; margin: 12px 0 6px; }
    .daily-health .tag { display: inline-block; padding: 2px 7px; border-radius: 10px; background: #eef3fa; font-size: 12px; }
    .daily-health .status-fail { color: #cf1322; background: #fff1f0; }
    .daily-health .status-warn { color: #ad6800; background: #fffbe6; }
    .daily-health .status-unable_to_judge { color: #595959; background: #f0f0f0; }
    .daily-health .status-pending_config { color: #0958d9; background: #e6f4ff; }
    .daily-health .status-not_applicable { color: #531dab; background: #f9f0ff; }
    .daily-health .status-normal { color: #237804; background: #f6ffed; }
    .daily-health .scope { color: #595959; font-size: 13px; }
    code { background: #f5f5f5; padding: 1px 4px; border-radius: 3px; }
  </style>
</head>
<body>
  <h1>PatrolX 巡检报告</h1>
  <p>
    任务：{{ task_id }} ｜ 数据包：{{ system.package_file }} ｜ 执行时间：{{ completed_at or "未完成" }}
  </p>
  <div class="stats">
    <div class="stat">总计 <b>{{ system.summary.total }}</b></div>
    <div class="stat" style="color:#52c41a">通过 <b>{{ system.summary.pass_ }}</b></div>
    <div class="stat" style="color:#faad14">告警 <b>{{ system.summary.warn }}</b></div>
    <div class="stat" style="color:#ff4d4f">失败 <b>{{ system.summary.fail }}</b></div>
    <div class="stat" style="color:#8c8c8c">异常 <b>{{ system.summary.error }}</b></div>
    <div class="stat" style="color:#1677ff">跳过 <b>{{ system.summary.skip }}</b></div>
  </div>
  {% if alarm_active %}
  <h2>告警优先处置</h2>
  <div class="alarm-priority">
    <div class="stats">
      <div class="stat">活动告警 <b>{{ alarm_active.active_records }}</b> 条</div>
      <div class="stat">活动分组 <b>{{ alarm_active.active_groups }}</b> 个</div>
      <div class="stat" style="color:#cf1322">最高严重级 <b>{{ alarm_active.highest_severity }}</b></div>
      <div class="stat">原始 Repeat Times 合计 <b>{{ alarm_active.raw_repeat_times_total }}</b> 次</div>
      <div class="stat">估算上报总数 <b>{{ alarm_active.estimated_report_total }}</b> 次</div>
    </div>
    <p><b>优先处置建议：</b>{{ alarm_active.recommendation }}</p>
    <p class="alarm-note">
      双计数口径：原始 Repeat Times 为 Σ Repeat Times；估算上报总数为 Σ(1 + Repeat Times)，不是精确事件总数。
    </p>
    <p class="alarm-note">
      观察末刻：{{ alarm_active.coverage_end_at }}；{{ alarm_active.observation_note }}。
      单条最大原始重复次数：{{ alarm_active.max_single_repeat_times }} 次。
    </p>
    {% if alarm_active.groups %}
    <h2>优先分组</h2>
    <table>
      <tr>
        <th>告警</th><th>严重级</th><th>对象</th><th>持续时长</th><th>原始重复</th><th>估算上报</th>
      </tr>
      {% for group in alarm_active.groups %}
      <tr>
        <td>{{ group.alarm_name }}（{{ group.app_name }} / {{ group.alarm_id }}）</td>
        <td>{{ group.severity }}</td>
        <td>{{ group.object }}</td>
        <td>{{ group.duration }}</td>
        <td>{{ group.raw_repeat_times_total }} 次</td>
        <td>{{ group.estimated_report_total }} 次</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
    {% for note in alarm_active.notes %}
    <p class="alarm-note">{{ note }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% if kpi_daily_health %}
  {% if kpi_daily_health.legacy %}
  <h2>KPI 日健康兼容提示</h2>
  <div class="daily-health">
    <p><b>旧任务无日健康结论</b></p>
    <p class="alarm-note">{{ kpi_daily_health.message }}</p>
  </div>
  {% else %}
  <h2>KPI 当前判定与昨日趋势</h2>
  <section class="daily-health" aria-label="KPI 当前判定与昨日趋势">
    <p>
      数据日期 {{ kpi_daily_health.data_date }}（{{ kpi_daily_health.timezone }}）
      ｜ 对比日 {{ kpi_daily_health.previous_date }}
      ｜ 最新测量时间 {{ kpi_daily_health.latest_measured_at }}
    </p>
    <div class="daily-health-grid">
      <div>
        <h3>当前判定分布</h3>
        <div class="stats">
          {% for item in kpi_daily_health.current_distribution %}
          <div class="stat"><span class="tag status-{{ item.status }}">{{ item.label }}</span> <b>{{ item.count }}</b></div>
          {% endfor %}
          <div class="stat">当前合计 <b>{{ kpi_daily_health.current_total }}</b></div>
        </div>
      </div>
      <div>
        <h3>较昨日分布</h3>
        <div class="stats">
          {% for item in kpi_daily_health.trend_distribution %}
          <div class="stat"><span class="tag">{{ item.label }}</span> <b>{{ item.count }}</b></div>
          {% endfor %}
          <div class="stat">趋势合计 <b>{{ kpi_daily_health.trend_total }}</b></div>
        </div>
      </div>
    </div>

    <h3>重点关注指标</h3>
    {% if kpi_daily_health.focus_metrics %}
    <table>
      <tr>
        <th>指标</th><th>当前</th><th>今日 / 昨日</th><th>变化</th><th>较昨日</th><th>依据</th>
      </tr>
      {% for metric in kpi_daily_health.focus_metrics %}
      <tr>
        <td>{{ metric.metric_resource_name_zh }}<br><small>{{ metric.measurement_unit_name_zh }} / {{ metric.metric_resource_id }}</small></td>
        <td><span class="tag status-{{ metric.current_status }}">{{ metric.current_status_label }}</span></td>
        <td>{{ metric.today_display }} / {{ metric.yesterday_display }}</td>
        <td>{{ metric.delta_display }}</td>
        <td>{{ metric.trend_status_label }}</td>
        <td>{{ metric.current_reason or metric.trend_reason }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p class="alarm-note">没有需要重点关注的指标。</p>
    {% endif %}

    {% if kpi_daily_health.zero_denominator_metrics %}
    <h3>零分母指标</h3>
    <table>
      <tr><th>指标</th><th>对象 / 周期</th><th>分子</th><th>分母</th><th>有效点</th></tr>
      {% for metric in kpi_daily_health.zero_denominator_metrics %}
      <tr>
        <td>{{ metric.metric_resource_name_zh }}（{{ metric.metric_resource_id }}）</td>
        <td>{{ metric.object_label }}</td>
        <td>{{ metric.numerator }}</td>
        <td>{{ metric.denominator }}</td>
        <td>{{ metric.valid_count }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}

    <h3>范围说明</h3>
    <p class="scope">
      启用测量单元 <b>{{ kpi_daily_health.scope.enabled_measurement_unit_count }}</b>
      ｜ 已确认绑定指标 <b>{{ kpi_daily_health.scope.confirmed_binding_metric_count }}</b>
      ｜ 本次预期指标 <b>{{ kpi_daily_health.scope.expected_metric_count }}</b>
      ｜ 范围外文件 <b>{{ kpi_daily_health.scope.out_of_scope_file_count }}</b>
      ｜ 未确认绑定 <b>{{ kpi_daily_health.scope.unconfirmed_binding_count }}</b>
    </p>
    {% if kpi_daily_health.scope.reasons %}
    <p class="scope">
      范围外原因：
      {% for reason in kpi_daily_health.scope.reasons %}
      {{ reason.label }} <b>{{ reason.count }}</b>{% if not loop.last %} ｜ {% endif %}
      {% endfor %}
    </p>
    {% endif %}
  </section>
  {% endif %}
  {% endif %}

  <h2>规则结果</h2>
  <table>
    <tr><th>规则</th><th>名称</th><th>状态</th><th>摘要</th><th>跳过原因</th></tr>
    {% for rule in system.rules %}
    <tr>
      <td><code>{{ rule.code }}</code></td>
      <td>{{ rule.name }}</td>
      <td><b>{{ rule.status.value }}</b></td>
      <td>{{ rule.summary or "" }}</td>
      <td>{{ rule.skip_reason or "" }}</td>
    </tr>
    {% endfor %}
  </table>

  {% if findings %}
  <h2>发现</h2>
  {% for rule, finding in findings %}
  <div class="finding">
    <b>[{{ finding.severity.value }}] {{ finding.title }}</b>
    <div>规则：{{ rule.code }} ｜ 优先级：{{ rule.priority.value }}</div>
    {% if finding.evidence %}<div><code>{{ finding.evidence }}</code></div>{% endif %}
    {% if finding.source_file %}<div>来源：{{ finding.source_file }}</div>{% endif %}
    {% if finding.recommendation %}<div>建议：{{ finding.recommendation }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}
</body>
</html>
