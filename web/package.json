{
  "name": "patrolx-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen-api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/client.ts",
    "test": "node --experimental-strip-types --test src/**/*.test.ts && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
